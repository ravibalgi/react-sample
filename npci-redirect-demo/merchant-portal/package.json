{
  "name": "merchant-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Merchant portal: React app that receives the NPCI ONMAGS XML response redirect, maps the fields and submits them to the backend.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/server.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fast-xml-parser": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "vite": "^7.2.0"
  }
}
